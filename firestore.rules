rules_version = '2';

// Isolamento por proprietário (Etapa 4).
// Cada motoboy só lê e grava dentro de users/{seu-uid}. Não há mais uid fixo:
// qualquer conta autenticada acessa exclusivamente os próprios dados (RD-03, RD-05, §6).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // true quando o usuário autenticado é o dono do caminho users/{userId}.
    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Perfil e TODA a subárvore do motoboy (rotas, clientes, abastecimentos,
    // manutenções, faturamento, financeiro, dados da moto...).
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Qualquer outro caminho é negado por padrão.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
